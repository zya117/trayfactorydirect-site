---
const { title } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>

  <style>
    body{
      font-family:Arial,sans-serif;
      max-width:1200px;
      margin:auto;
      padding:20px;
      line-height:1.7;
    }

    nav{
      margin-bottom:30px;
    }

    nav a{
      margin-right:20px;
      text-decoration:none;
    }

    footer{
      margin-top:50px;
      border-top:1px solid #ddd;
      padding-top:20px;
    }
  </style>
</head>

<body>

<nav>
  <a href="/">Home</a>
  <a href="/about">About</a>
  <a href="/products">Products</a>
  <a href="/contact">Contact</a>
</nav>

<main>
  <slot />
</main>

<footer>
  © 2026 Tray Factory Direct
</footer>

</body>
</html>